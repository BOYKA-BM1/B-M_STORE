// Software Marketplace - Production Prisma Schema
// Supports: Projects, Demos, Analytics, Orders (future), RBAC, Audit

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProjectStatus {
  DRAFT
  PRIVATE
  PUBLISHED
  ARCHIVED
}

enum DemoMode {
  AUTO
  EXTERNAL_URL
  DISABLED
}

enum DemoStatus {
  QUEUED
  UPLOADING
  INSPECTING
  BUILDING
  TESTING
  STARTING
  READY
  FAILED
  STOPPED
  EXPIRED
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum MediaType {
  COVER
  SCREENSHOT
  VIDEO
  OTHER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  profile       Profile?
  auditLogs     AuditLog[]
  orders        Order[]
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String?
  phone       String?
  avatarUrl   String?
  locale      String   @default("ar")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  nameAr      String?
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  projects  ProjectTag[]
}

model Project {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  shortDescription String?
  fullDescription String?        @db.Text
  status          ProjectStatus  @default(DRAFT)
  priceEgp        Decimal        @db.Decimal(12, 2)
  priceUsd        Decimal?       @db.Decimal(12, 2)
  oldPriceEgp     Decimal?       @db.Decimal(12, 2)
  discountPercent Int?

  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])

  technologies    String[]       // e.g. ["Next.js", "PostgreSQL"]
  framework       String?
  runtime         String?
  requirements    String?        @db.Text
  version         String         @default("1.0.0")
  features        String[]

  demoMode        DemoMode       @default(DISABLED)
  demoExternalUrl String?
  demoUsername    String?
  demoPassword    String?

  coverImageUrl   String?
  isFeatured      Boolean        @default(false)
  viewCount       Int            @default(0)
  whatsappClicks  Int            @default(0)
  demoClicks      Int            @default(0)

  sourceFileKey   String?        // private storage key for ZIP
  sourceFileSize  Int?
  sourceFileHash  String?
  securityScanPassed Boolean     @default(false)
  detectedType    String?

  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  media           ProjectMedia[]
  tags            ProjectTag[]
  builds          ProjectBuild[]
  demos           ProjectDemo[]
  views           ProjectView[]
  whatsappEvents  WhatsAppClick[]
  demoEvents      DemoEvent[]
  orders          OrderItem[]
  faq             ProjectFaq[]

  @@index([status])
  @@index([categoryId])
  @@index([slug])
  @@index([isFeatured])
  @@index([createdAt])
}

model ProjectMedia {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      MediaType @default(SCREENSHOT)
  url       String
  alt       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([projectId])
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model ProjectFaq {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
}

model ProjectBuild {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        BuildStatus @default(QUEUED)
  detectedType  String?
  logs          String?     @db.Text
  errorMessage  String?     @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  demo          ProjectDemo?

  @@index([projectId])
  @@index([status])
}

model ProjectDemo {
  id            String     @id @default(uuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildId       String?    @unique
  build         ProjectBuild? @relation(fields: [buildId], references: [id])
  status        DemoStatus @default(QUEUED)
  demoUrl       String?
  containerId   String?    // internal only
  logs          String?    @db.Text
  errorMessage  String?    @db.Text
  startedAt     DateTime?
  finishedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions      DemoSession[]

  @@index([projectId])
  @@index([status])
}

model DemoSession {
  id        String      @id @default(uuid())
  demoId    String
  demo      ProjectDemo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  ipHash    String?
  userAgent String?
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  @@index([demoId])
}

model ProjectView {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ipHash    String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model WhatsAppClick {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // "purchase" | "customization"
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model DemoEvent {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType String   // "click" | "start" | "ready" | "fail"
  meta      Json?
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model Order {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)
  totalEgp    Decimal     @db.Decimal(12, 2)
  customerName String?
  customerPhone String?
  customerEmail String?
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  priceEgp  Decimal @db.Decimal(12, 2)
  quantity  Int     @default(1)
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SearchQuery {
  id        String   @id @default(uuid())
  query     String
  results   Int      @default(0)
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
