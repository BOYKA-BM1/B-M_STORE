{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/projects/analyze/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/upload/route.ts": {
      "maxDuration": 30
    },
    "src/app/d/[slug]/[[...path]]/route.ts": {
      "maxDuration": 15
    }
  }
}
